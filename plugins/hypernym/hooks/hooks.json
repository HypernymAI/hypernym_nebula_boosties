{
  "description": "hypernym: keep the status line launcher current; tell each new, resumed, cleared or compacted session about this repo's analysis; remember which package a session loaded (local only, never the network); in Codex, show the Zephyr status row in the conversation.",
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "timeout": 10,
                     "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/skills/hypernym/scripts/session_start.py\"" } ] },
      { "matcher": "startup|resume|clear|compact",
        "hooks": [ { "type": "command", "timeout": 10,
                     "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/skills/hypernym/scripts/session_context.py\"" } ] },
      { "matcher": "startup|resume|clear",
        "hooks": [ { "type": "command", "timeout": 10,
                     "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/skills/hypernym/scripts/codex_status.py\"" } ] }
    ],
    "PostToolUse": [
      { "matcher": "Bash|mcp__.*hypernym_load",
        "hooks": [ { "type": "command", "timeout": 10,
                     "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/skills/hypernym/scripts/record_load.py\"" } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "timeout": 10,
                     "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/skills/hypernym/scripts/codex_status.py\"" } ] }
    ]
  }
}
