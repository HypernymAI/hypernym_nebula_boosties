#!/bin/sh
# nebula launcher: run one of the plugin's Python entry points inside the plugin's OWN environment.
#   nebula-run <script.py> [args...]
#   nebula-run --check     prints "ok" when nebula can run here, else the reason (exit 1) — no Python started
# The environment is created by uv on first use (Python 3.13 + numpy, pinned by uv.lock) inside this plugin directory.
# That one-time install is the ONLY time anything is downloaded, and it downloads packages — never your data.
# Everything after that runs offline under noegress.py.
# When nebula CANNOT run here (not macOS on Apple Silicon — the native scorer is arm64-only — or no uv), the status
# line and the /nebula: commands say why (exit 1 + the reason); the HOOKS stay silent (exit 0) so Claude Code does
# not show an error after every turn. The reason is still visible every second in the status line.
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
SCRIPT="$1"
shift
cannot() {
  case "$SCRIPT" in
    session_start.py|hook_stop.py|hook_user_prompt.py) cat > /dev/null; exit 0 ;;
  esac
  echo "$1" >&2
  exit 1
}
if [ "$(uname -s)" != Darwin ] || [ "$(uname -m)" != arm64 ]; then
  cannot "nebula needs macOS on Apple Silicon (this is $(uname -s) $(uname -m)) — the hypernym plugin still works here"
fi
UV="$(command -v uv 2>/dev/null)"
for c in "$HOME/.local/bin/uv" "$HOME/.cargo/bin/uv" /opt/homebrew/bin/uv /usr/local/bin/uv; do
  if [ -z "$UV" ] && [ -x "$c" ]; then UV="$c"; fi
done
if [ -z "$UV" ]; then
  cannot "nebula needs uv — install: curl -LsSf https://astral.sh/uv/install.sh | sh — then start a new session"
fi
if [ "$SCRIPT" = --check ]; then echo ok; exit 0; fi
exec "$UV" run --project "$ROOT" --frozen --quiet --no-dev python "$ROOT/shield/$SCRIPT" "$@"
