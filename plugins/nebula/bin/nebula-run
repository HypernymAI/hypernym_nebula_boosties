#!/bin/sh
# nebula launcher: run one of the plugin's Python entry points inside the plugin's OWN environment.
#   nebula-run <script.py> [args...]
#   nebula-run --check     prints "ok" when nebula can run here, else the reason (exit 1) — no Python started
# The environment is created by uv on first use (Python 3.13 + numpy, pinned by uv.lock) inside this plugin directory.
# That one-time install is the ONLY time anything is downloaded, and it downloads packages — never your data.
# Everything after that runs offline under noegress.py.
# Runs on: macOS 11+ (Apple Silicon or Intel) and Linux x86-64 / ARM64 with glibc 2.28+ — one prebuilt native scorer
# per platform in ctxshield/ (native/PLATFORMS.json). When nebula CANNOT run here (Windows — use WSL —, Alpine/musl,
# older macOS or glibc, another CPU, or no uv), the status
# line and the /nebula: commands say why (exit 1 + the reason); the HOOKS stay silent (exit 0) so Claude Code does
# not show an error after every turn. The reason is still visible every second in the status line.
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
SCRIPT="$1"
shift
cannot() {
  case "$SCRIPT" in
    session_start.py|hook_stop.py|hook_user_prompt.py) cat > /dev/null; exit 0 ;;
  esac
  echo "$1" >&2
  exit 1
}
OS="$(uname -s)"; CPU="$(uname -m)"
case "$OS" in
  Darwin)
    case "$CPU" in arm64|x86_64) ;; *) cannot "nebula does not run on $OS $CPU — the hypernym plugin still works here" ;; esac
    MACV="$(sw_vers -productVersion 2>/dev/null)"
    if [ "${MACV%%.*}" -lt 11 ] 2>/dev/null; then
      cannot "nebula needs macOS 11 or newer (this is $MACV) — the hypernym plugin still works here"
    fi ;;
  Linux)
    case "$CPU" in x86_64|aarch64|arm64) ;; *) cannot "nebula does not run on Linux $CPU (x86-64 and ARM64 only) — the hypernym plugin still works here" ;; esac
    GLIBC="$(getconf GNU_LIBC_VERSION 2>/dev/null | awk '{print $2}')"
    if [ -z "$GLIBC" ]; then
      cannot "nebula needs a glibc Linux (Alpine/musl is not supported yet) — the hypernym plugin still works here"
    fi
    GMAJ="${GLIBC%%.*}"; GMIN="${GLIBC#*.}"; GMIN="${GMIN%%.*}"
    if [ "$GMAJ" -lt 2 ] || { [ "$GMAJ" -eq 2 ] && [ "$GMIN" -lt 28 ]; }; then
      cannot "nebula needs glibc 2.28 or newer (this is $GLIBC) — the hypernym plugin still works here"
    fi ;;
  MINGW*|MSYS*|CYGWIN*|Windows*)
    cannot "nebula does not run on Windows yet — run Claude Code in WSL (Linux), where it works; the hypernym plugin still works here" ;;
  *)
    cannot "nebula does not run on $OS $CPU — the hypernym plugin still works here" ;;
esac
UV="$(command -v uv 2>/dev/null)"
for c in "$HOME/.local/bin/uv" "$HOME/.cargo/bin/uv" /opt/homebrew/bin/uv /usr/local/bin/uv; do
  if [ -z "$UV" ] && [ -x "$c" ]; then UV="$c"; fi
done
if [ -z "$UV" ]; then
  cannot "nebula needs uv — install: curl -LsSf https://astral.sh/uv/install.sh | sh — then start a new session"
fi
if [ "$SCRIPT" = --check ]; then echo ok; exit 0; fi
exec "$UV" run --project "$ROOT" --frozen --quiet --no-dev python "$ROOT/shield/$SCRIPT" "$@"
